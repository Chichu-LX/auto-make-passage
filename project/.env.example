# The runtime reads ../.env automatically. These OpenAI-compatible names let you
# switch providers by changing the key, base URL, and model without editing code.
OPENAI_API_KEY=replace_me
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
OPENAI_REASONING_EFFORT=high
TAVILY_API_KEY=replace_me
TAVILY_SEARCH_DEPTH=advanced

# Optional: use the real Claude Agent SDK only for Paper Review and Feedback.
# Runtime/Lead still own dispatch and LangGraph state transitions.
ANTHROPIC_API_KEY=replace_me
CLAUDE_AGENT_SDK_ENABLED=false
CLAUDE_AGENT_MODEL=Codex-opus-4-6

# Backward-compatible aliases (optional): DEEPSEEK_API_KEY, DEEPSEEK_BASE_URL,
# and DEEPSEEK_MODEL. OPENAI_* values take precedence when both are present.
