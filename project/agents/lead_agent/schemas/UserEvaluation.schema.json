{
  "$defs": {
    "AgentName": {
      "enum": [
        "lead-agent",
        "download-paper-agent",
        "download-data-agent",
        "make-idea-agent",
        "idea-design-agent",
        "code-make-agent",
        "code-review-agent",
        "server-schedule-agent",
        "check-result-agent",
        "experiment-code-run-agent",
        "check-paper-and-code-agent",
        "write-paper-agent",
        "paper-review-agent",
        "feedback-agent"
      ],
      "title": "AgentName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A user-authored verdict consumed only by the Runtime control plane.",
  "properties": {
    "comments": {
      "default": "",
      "maxLength": 5000,
      "title": "Comments",
      "type": "string"
    },
    "observed_state_version": {
      "minimum": 1,
      "title": "Observed State Version",
      "type": "integer"
    },
    "rating": {
      "anyOf": [
        {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rating"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    },
    "target_agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentName"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verdict": {
      "enum": [
        "satisfied",
        "needs_revision"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "review_id",
    "observed_state_version",
    "verdict"
  ],
  "title": "UserEvaluation",
  "type": "object"
}
