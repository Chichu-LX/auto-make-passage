{
  "$defs": {
    "AgentName": {
      "enum": [
        "lead-agent",
        "download-paper-agent",
        "download-data-agent",
        "make-idea-agent",
        "idea-design-agent",
        "code-make-agent",
        "code-review-agent",
        "server-schedule-agent",
        "check-result-agent",
        "experiment-code-run-agent",
        "check-paper-and-code-agent",
        "write-paper-agent",
        "paper-review-agent",
        "feedback-agent"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "WorkflowState": {
      "enum": [
        "ACQUIRING_PAPERS",
        "IDEATING",
        "DESIGNING_IDEA",
        "ACQUIRING_DATA",
        "IMPLEMENTING",
        "CODE_REVIEW",
        "RUNNING",
        "RESULT_CHECK",
        "EXPERIMENT_CODE_RUN",
        "WRITING",
        "CONSISTENCY_REVIEW",
        "PAPER_REVIEW",
        "AWAITING_USER_REVIEW",
        "NEEDS_HUMAN",
        "COMPLETED",
        "CANCELLED",
        "ABORTED",
        "FAILED"
      ],
      "title": "WorkflowState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A persisted after-step checkpoint that must be resolved by a user.",
  "properties": {
    "allowed_revision_targets": {
      "items": {
        "$ref": "#/$defs/AgentName"
      },
      "title": "Allowed Revision Targets",
      "type": "array"
    },
    "artifact_kinds": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Artifact Kinds",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "default_revision_target": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentName"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "feedback_action": {
      "enum": [
        "continue",
        "retry",
        "request_human",
        "abort"
      ],
      "title": "Feedback Action",
      "type": "string"
    },
    "feedback_reason": {
      "default": "",
      "maxLength": 3000,
      "title": "Feedback Reason",
      "type": "string"
    },
    "issue_codes": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Issue Codes",
      "type": "array"
    },
    "prior_artifact_count": {
      "minimum": 0,
      "title": "Prior Artifact Count",
      "type": "integer"
    },
    "prior_completed_agent_count": {
      "minimum": 0,
      "title": "Prior Completed Agent Count",
      "type": "integer"
    },
    "prior_gate_attempts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Prior Gate Attempts",
      "type": "object"
    },
    "proposed_state": {
      "$ref": "#/$defs/WorkflowState"
    },
    "result_status": {
      "enum": [
        "succeeded",
        "in_progress",
        "failed",
        "blocked",
        "needs_human"
      ],
      "title": "Result Status",
      "type": "string"
    },
    "result_summary": {
      "maxLength": 3000,
      "minLength": 1,
      "title": "Result Summary",
      "type": "string"
    },
    "review_id": {
      "pattern": "^review_[A-Za-z0-9_-]{1,160}$",
      "title": "Review Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_agent": {
      "$ref": "#/$defs/AgentName"
    },
    "source_state": {
      "$ref": "#/$defs/WorkflowState"
    },
    "source_task_id": {
      "title": "Source Task Id",
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "source_state",
    "proposed_state",
    "source_agent",
    "source_task_id",
    "result_status",
    "result_summary",
    "feedback_action",
    "prior_artifact_count",
    "prior_completed_agent_count"
  ],
  "title": "UserReviewRequest",
  "type": "object"
}
