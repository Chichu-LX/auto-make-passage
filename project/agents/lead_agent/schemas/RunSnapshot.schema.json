{
  "$defs": {
    "AgentName": {
      "enum": [
        "lead-agent",
        "download-paper-agent",
        "download-data-agent",
        "make-idea-agent",
        "idea-design-agent",
        "code-make-agent",
        "code-review-agent",
        "server-schedule-agent",
        "check-result-agent",
        "experiment-code-run-agent",
        "check-paper-and-code-agent",
        "write-paper-agent",
        "paper-review-agent",
        "feedback-agent"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "generic",
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "default": "",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "UserReviewRequest": {
      "additionalProperties": false,
      "description": "A persisted after-step checkpoint that must be resolved by a user.",
      "properties": {
        "allowed_revision_targets": {
          "items": {
            "$ref": "#/$defs/AgentName"
          },
          "title": "Allowed Revision Targets",
          "type": "array"
        },
        "artifact_kinds": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Artifact Kinds",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "default_revision_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "feedback_action": {
          "enum": [
            "continue",
            "retry",
            "request_human",
            "abort"
          ],
          "title": "Feedback Action",
          "type": "string"
        },
        "feedback_reason": {
          "default": "",
          "maxLength": 3000,
          "title": "Feedback Reason",
          "type": "string"
        },
        "issue_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Issue Codes",
          "type": "array"
        },
        "prior_artifact_count": {
          "minimum": 0,
          "title": "Prior Artifact Count",
          "type": "integer"
        },
        "prior_completed_agent_count": {
          "minimum": 0,
          "title": "Prior Completed Agent Count",
          "type": "integer"
        },
        "prior_gate_attempts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Prior Gate Attempts",
          "type": "object"
        },
        "proposed_state": {
          "$ref": "#/$defs/WorkflowState"
        },
        "result_status": {
          "enum": [
            "succeeded",
            "in_progress",
            "failed",
            "blocked",
            "needs_human"
          ],
          "title": "Result Status",
          "type": "string"
        },
        "result_summary": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Result Summary",
          "type": "string"
        },
        "review_id": {
          "pattern": "^review_[A-Za-z0-9_-]{1,160}$",
          "title": "Review Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_agent": {
          "$ref": "#/$defs/AgentName"
        },
        "source_state": {
          "$ref": "#/$defs/WorkflowState"
        },
        "source_task_id": {
          "title": "Source Task Id",
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "source_state",
        "proposed_state",
        "source_agent",
        "source_task_id",
        "result_status",
        "result_summary",
        "feedback_action",
        "prior_artifact_count",
        "prior_completed_agent_count"
      ],
      "title": "UserReviewRequest",
      "type": "object"
    },
    "UserRevisionNote": {
      "additionalProperties": false,
      "description": "Accepted user feedback forwarded to the next allowlisted repair task.",
      "properties": {
        "comments": {
          "maxLength": 5000,
          "minLength": 3,
          "title": "Comments",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating"
        },
        "rejected_agent": {
          "$ref": "#/$defs/AgentName"
        },
        "review_id": {
          "title": "Review Id",
          "type": "string"
        },
        "source_state": {
          "$ref": "#/$defs/WorkflowState"
        },
        "target_agent": {
          "$ref": "#/$defs/AgentName"
        }
      },
      "required": [
        "review_id",
        "rejected_agent",
        "target_agent",
        "source_state",
        "comments"
      ],
      "title": "UserRevisionNote",
      "type": "object"
    },
    "WorkflowState": {
      "enum": [
        "ACQUIRING_PAPERS",
        "IDEATING",
        "DESIGNING_IDEA",
        "ACQUIRING_DATA",
        "IMPLEMENTING",
        "CODE_REVIEW",
        "RUNNING",
        "RESULT_CHECK",
        "EXPERIMENT_CODE_RUN",
        "WRITING",
        "CONSISTENCY_REVIEW",
        "PAPER_REVIEW",
        "AWAITING_USER_REVIEW",
        "NEEDS_HUMAN",
        "COMPLETED",
        "CANCELLED",
        "ABORTED",
        "FAILED"
      ],
      "title": "WorkflowState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "blocked_from": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "completed_agents": {
      "items": {
        "$ref": "#/$defs/AgentName"
      },
      "title": "Completed Agents",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "execution_mode": {
      "default": "mock",
      "enum": [
        "mock",
        "live"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "gate_attempts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Gate Attempts",
      "type": "object"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "pending_user_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserReviewRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "project_slug": {
      "default": "legacy",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
      "title": "Project Slug",
      "type": "string"
    },
    "queued_user_reviews": {
      "items": {
        "$ref": "#/$defs/UserReviewRequest"
      },
      "maxItems": 1,
      "title": "Queued User Reviews",
      "type": "array"
    },
    "revision_history": {
      "items": {
        "$ref": "#/$defs/UserRevisionNote"
      },
      "maxItems": 100,
      "title": "Revision History",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/WorkflowState"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "objective",
    "state",
    "version"
  ],
  "title": "RunSnapshot",
  "type": "object"
}
