{
  "$defs": {
    "AgentName": {
      "enum": [
        "lead-agent",
        "download-paper-agent",
        "download-data-agent",
        "make-idea-agent",
        "idea-design-agent",
        "code-make-agent",
        "code-review-agent",
        "server-schedule-agent",
        "check-result-agent",
        "experiment-code-run-agent",
        "check-paper-and-code-agent",
        "write-paper-agent",
        "paper-review-agent",
        "feedback-agent"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "WorkflowState": {
      "enum": [
        "ACQUIRING_PAPERS",
        "IDEATING",
        "DESIGNING_IDEA",
        "ACQUIRING_DATA",
        "IMPLEMENTING",
        "CODE_REVIEW",
        "RUNNING",
        "RESULT_CHECK",
        "EXPERIMENT_CODE_RUN",
        "WRITING",
        "CONSISTENCY_REVIEW",
        "PAPER_REVIEW",
        "AWAITING_USER_REVIEW",
        "NEEDS_HUMAN",
        "COMPLETED",
        "CANCELLED",
        "ABORTED",
        "FAILED"
      ],
      "title": "WorkflowState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Lead's authoritative semantic choice between policy-safe state candidates.",
  "properties": {
    "action": {
      "enum": [
        "advance",
        "retry",
        "continue",
        "wait",
        "request_human",
        "complete",
        "abort"
      ],
      "title": "Action",
      "type": "string"
    },
    "considered_issue_codes": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Considered Issue Codes",
      "type": "array"
    },
    "observed_state_version": {
      "minimum": 1,
      "title": "Observed State Version",
      "type": "integer"
    },
    "phase": {
      "enum": [
        "specialist_result",
        "feedback_control",
        "user_evaluation",
        "human_resume",
        "human_retry"
      ],
      "title": "Phase",
      "type": "string"
    },
    "reason": {
      "maxLength": 3000,
      "minLength": 5,
      "title": "Reason",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_option_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,95}$",
      "title": "Selected Option Id",
      "type": "string"
    },
    "target_agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentName"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "target_state": {
      "$ref": "#/$defs/WorkflowState"
    }
  },
  "required": [
    "run_id",
    "observed_state_version",
    "phase",
    "selected_option_id",
    "action",
    "target_state",
    "reason"
  ],
  "title": "LeadTransitionDecision",
  "type": "object"
}
