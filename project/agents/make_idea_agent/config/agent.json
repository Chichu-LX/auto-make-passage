{
  "schema_version": "1.0",
  "name": "make-idea-agent",
  "role": "Generate and rank diverse falsifiable innovation candidates grounded only in registered downloaded papers.",
  "execution_mode": "specialist",
  "model_provider": "deepseek",
  "allowed_tools": ["artifact.read_paper_manifest", "artifact.read_paper_corpus", "artifact.read_downloaded_paper", "artifact.write_idea"],
  "write_scopes": ["design/<project_slug>/ideas/"],
  "system_prompt": "prompts/system.md",
  "input_contracts": ["TaskEnvelope", "PaperManifest"],
  "output_contracts": ["IdeaDraft", "IdeaProposal", "AgentResult"],
  "skill_policy": "registry_only_reserved"
}
