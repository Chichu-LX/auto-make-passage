{
  "$defs": {
    "AdvisorReport": {
      "additionalProperties": false,
      "description": "Read-only, strongly typed output of one bounded Idea Design auxiliary Agent.",
      "properties": {
        "advisor": {
          "enum": [
            "method-architecture-advisor",
            "code-reuse-architecture-advisor",
            "data-decision-advisor",
            "experiment-decision-advisor",
            "critical-risk-advisor"
          ],
          "title": "Advisor",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Assumptions",
          "type": "array"
        },
        "blocking_concerns": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Blocking Concerns",
          "type": "array"
        },
        "decisions": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Decisions",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "issue_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Issue Codes",
          "type": "array"
        },
        "recommendations": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Recommendations",
          "type": "array"
        }
      },
      "required": [
        "advisor",
        "recommendations",
        "decisions",
        "evidence_refs",
        "assumptions"
      ],
      "title": "AdvisorReport",
      "type": "object"
    },
    "CodeBlueprint": {
      "additionalProperties": false,
      "properties": {
        "config_contracts": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Config Contracts",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Dependencies",
          "type": "array"
        },
        "entrypoints": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Entrypoints",
          "type": "array"
        },
        "minimum_viable_implementation": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 3,
          "title": "Minimum Viable Implementation",
          "type": "array"
        },
        "packages": {
          "items": {
            "$ref": "#/$defs/CodePackageSpec"
          },
          "maxItems": 30,
          "minItems": 3,
          "title": "Packages",
          "type": "array"
        },
        "pipeline": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 5,
          "title": "Pipeline",
          "type": "array"
        },
        "tests": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "minItems": 3,
          "title": "Tests",
          "type": "array"
        }
      },
      "required": [
        "pipeline",
        "packages",
        "entrypoints",
        "config_contracts",
        "tests",
        "dependencies",
        "minimum_viable_implementation"
      ],
      "title": "CodeBlueprint",
      "type": "object"
    },
    "CodePackageSpec": {
      "additionalProperties": false,
      "properties": {
        "key_interfaces": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Key Interfaces",
          "type": "array"
        },
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "reference_module_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Reference Module Ids",
          "type": "array"
        },
        "responsibility": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Responsibility",
          "type": "string"
        }
      },
      "required": [
        "path",
        "responsibility",
        "key_interfaces"
      ],
      "title": "CodePackageSpec",
      "type": "object"
    },
    "DataAuditPlan": {
      "additionalProperties": false,
      "description": "Pre-download and post-download checks that gate every dataset used by the design.",
      "properties": {
        "acceptance_gates": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 2,
          "title": "Acceptance Gates",
          "type": "array"
        },
        "dataset_key": {
          "pattern": "^dataset-[a-zA-Z0-9_-]{1,64}$",
          "title": "Dataset Key",
          "type": "string"
        },
        "distribution_shift_checks": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 2,
          "title": "Distribution Shift Checks",
          "type": "array"
        },
        "duplicate_conflict_policy": {
          "maxLength": 3000,
          "minLength": 10,
          "title": "Duplicate Conflict Policy",
          "type": "string"
        },
        "leakage_checks": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 2,
          "title": "Leakage Checks",
          "type": "array"
        },
        "missingness_policy": {
          "maxLength": 3000,
          "minLength": 10,
          "title": "Missingness Policy",
          "type": "string"
        },
        "schema_checks": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 2,
          "title": "Schema Checks",
          "type": "array"
        }
      },
      "required": [
        "dataset_key",
        "schema_checks",
        "leakage_checks",
        "duplicate_conflict_policy",
        "missingness_policy",
        "distribution_shift_checks",
        "acceptance_gates"
      ],
      "title": "DataAuditPlan",
      "type": "object"
    },
    "DatasetRequirement": {
      "additionalProperties": false,
      "description": "A pre-download requirement; reported scale/distribution are hypotheses to verify.",
      "properties": {
        "acquisition_query": {
          "maxLength": 1000,
          "minLength": 5,
          "title": "Acquisition Query",
          "type": "string"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Alternatives",
          "type": "array"
        },
        "candidate_names": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Candidate Names",
          "type": "array"
        },
        "contents": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Contents",
          "type": "array"
        },
        "dataset_key": {
          "pattern": "^dataset-[a-zA-Z0-9_-]{1,64}$",
          "title": "Dataset Key",
          "type": "string"
        },
        "distribution_checks": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 2,
          "title": "Distribution Checks",
          "type": "array"
        },
        "expected_distribution": {
          "maxLength": 3000,
          "minLength": 5,
          "title": "Expected Distribution",
          "type": "string"
        },
        "license_requirement": {
          "maxLength": 1000,
          "minLength": 5,
          "title": "License Requirement",
          "type": "string"
        },
        "official_source_urls": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Official Source Urls",
          "type": "array"
        },
        "paper_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Paper Refs",
          "type": "array"
        },
        "priority": {
          "enum": [
            "required",
            "preferred",
            "optional"
          ],
          "title": "Priority",
          "type": "string"
        },
        "reliability_basis": {
          "maxLength": 3000,
          "minLength": 10,
          "title": "Reliability Basis",
          "type": "string"
        },
        "reported_scale": {
          "maxLength": 2000,
          "minLength": 5,
          "title": "Reported Scale",
          "type": "string"
        },
        "required_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Required Fields",
          "type": "array"
        },
        "source_kind": {
          "const": "external_dataset",
          "title": "Source Kind",
          "type": "string"
        },
        "split_strategy": {
          "maxLength": 3000,
          "minLength": 10,
          "title": "Split Strategy",
          "type": "string"
        }
      },
      "required": [
        "dataset_key",
        "source_kind",
        "candidate_names",
        "priority",
        "acquisition_query",
        "contents",
        "required_fields",
        "reported_scale",
        "expected_distribution",
        "distribution_checks",
        "split_strategy",
        "reliability_basis",
        "license_requirement",
        "paper_refs"
      ],
      "title": "DatasetRequirement",
      "type": "object"
    },
    "DesignDecision": {
      "additionalProperties": false,
      "description": "One ADR-style research or engineering decision with an explicit revisit rule.",
      "properties": {
        "decision_id": {
          "pattern": "^decision-[a-zA-Z0-9_-]{1,64}$",
          "title": "Decision Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Question",
          "type": "string"
        },
        "rationale": {
          "maxLength": 3000,
          "minLength": 10,
          "title": "Rationale",
          "type": "string"
        },
        "revisit_trigger": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Revisit Trigger",
          "type": "string"
        },
        "selected_option": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Selected Option",
          "type": "string"
        },
        "tradeoffs": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Tradeoffs",
          "type": "array"
        }
      },
      "required": [
        "decision_id",
        "question",
        "options",
        "selected_option",
        "rationale",
        "tradeoffs",
        "evidence_refs",
        "revisit_trigger"
      ],
      "title": "DesignDecision",
      "type": "object"
    },
    "ExpectedResult": {
      "additionalProperties": false,
      "properties": {
        "claim_status": {
          "const": "predicted_not_observed",
          "default": "predicted_not_observed",
          "title": "Claim Status",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "expectation": {
          "maxLength": 3000,
          "minLength": 10,
          "title": "Expectation",
          "type": "string"
        },
        "expected_direction": {
          "enum": [
            "higher",
            "lower",
            "stable",
            "two_sided"
          ],
          "title": "Expected Direction",
          "type": "string"
        },
        "experiment_id": {
          "title": "Experiment Id",
          "type": "string"
        },
        "failure_threshold": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Failure Threshold",
          "type": "string"
        },
        "metric": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "result_id": {
          "pattern": "^result-[a-zA-Z0-9_-]{1,64}$",
          "title": "Result Id",
          "type": "string"
        },
        "target_delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumericRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "result_id",
        "experiment_id",
        "metric",
        "expected_direction",
        "expectation",
        "evidence_refs",
        "failure_threshold"
      ],
      "title": "ExpectedResult",
      "type": "object"
    },
    "ExperimentPlan": {
      "additionalProperties": false,
      "properties": {
        "baselines": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Baselines",
          "type": "array"
        },
        "computational_only": {
          "const": true,
          "default": true,
          "title": "Computational Only",
          "type": "boolean"
        },
        "controls": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Controls",
          "type": "array"
        },
        "dataset_keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Dataset Keys",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "experiment_id": {
          "pattern": "^experiment-[a-zA-Z0-9_-]{1,64}$",
          "title": "Experiment Id",
          "type": "string"
        },
        "experiment_type": {
          "enum": [
            "main_benchmark",
            "ablation",
            "case_study",
            "module_analysis",
            "feasibility",
            "sensitivity",
            "ood_generalization",
            "efficiency",
            "uncertainty_calibration"
          ],
          "title": "Experiment Type",
          "type": "string"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "objective": {
          "maxLength": 3000,
          "minLength": 10,
          "title": "Objective",
          "type": "string"
        },
        "protocol": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "minItems": 2,
          "title": "Protocol",
          "type": "array"
        },
        "random_seeds": {
          "items": {
            "type": "integer"
          },
          "maxItems": 50,
          "minItems": 3,
          "title": "Random Seeds",
          "type": "array"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Success Criteria",
          "type": "array"
        },
        "variables": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Variables",
          "type": "array"
        }
      },
      "required": [
        "experiment_id",
        "experiment_type",
        "objective",
        "dataset_keys",
        "baselines",
        "variables",
        "controls",
        "metrics",
        "random_seeds",
        "protocol",
        "success_criteria",
        "evidence_refs"
      ],
      "title": "ExperimentPlan",
      "type": "object"
    },
    "ExperimentStagePlan": {
      "additionalProperties": false,
      "description": "Budgeted stage gate for baseline-first, falsifiable experiment execution.",
      "properties": {
        "attempt_budget": {
          "maximum": 20,
          "minimum": 1,
          "title": "Attempt Budget",
          "type": "integer"
        },
        "entry_gate": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Entry Gate",
          "type": "array"
        },
        "escalation": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Escalation",
          "type": "string"
        },
        "exit_gate": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Exit Gate",
          "type": "array"
        },
        "objective": {
          "maxLength": 3000,
          "minLength": 10,
          "title": "Objective",
          "type": "string"
        },
        "stage_id": {
          "pattern": "^stage-[a-zA-Z0-9_-]{1,64}$",
          "title": "Stage Id",
          "type": "string"
        },
        "stage_type": {
          "enum": [
            "data_validation",
            "baseline_reproduction",
            "tuning",
            "proposed_method",
            "ablation",
            "stress_test"
          ],
          "title": "Stage Type",
          "type": "string"
        },
        "stop_conditions": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Stop Conditions",
          "type": "array"
        }
      },
      "required": [
        "stage_id",
        "stage_type",
        "objective",
        "attempt_budget",
        "entry_gate",
        "exit_gate",
        "stop_conditions",
        "escalation"
      ],
      "title": "ExperimentStagePlan",
      "type": "object"
    },
    "ImplementationMilestone": {
      "additionalProperties": false,
