{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "generic",
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "default": "",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "DownloadPolicyRecord": {
      "additionalProperties": false,
      "properties": {
        "allowed_content_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Content Types",
          "type": "array"
        },
        "max_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Bytes",
          "type": "integer"
        },
        "max_redirects": {
          "maximum": 10,
          "minimum": 0,
          "title": "Max Redirects",
          "type": "integer"
        }
      },
      "required": [
        "max_bytes",
        "max_redirects",
        "allowed_content_types"
      ],
      "title": "DownloadPolicyRecord",
      "type": "object"
    },
    "PaperQualityPolicyRecord": {
      "additionalProperties": false,
      "properties": {
        "arxiv_is_fallback": {
          "default": true,
          "title": "Arxiv Is Fallback",
          "type": "boolean"
        },
        "authoritative_ratio": {
          "default": 0.7,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Authoritative Ratio",
          "type": "number"
        },
        "authoritative_venues": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Authoritative Venues",
          "type": "array"
        },
        "portfolio_size": {
          "default": 10,
          "maximum": 500,
          "minimum": 1,
          "title": "Portfolio Size",
          "type": "integer"
        },
        "recent_ratio": {
          "default": 0.3,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Recent Ratio",
          "type": "number"
        },
        "recent_since_year": {
          "maximum": 2200,
          "minimum": 2000,
          "title": "Recent Since Year",
          "type": "integer"
        },
        "require_verified_pdf": {
          "default": true,
          "title": "Require Verified Pdf",
          "type": "boolean"
        }
      },
      "required": [
        "recent_since_year",
        "authoritative_venues"
      ],
      "title": "PaperQualityPolicyRecord",
      "type": "object"
    },
    "PaperRecord": {
      "additionalProperties": false,
      "properties": {
        "abstract": {
          "default": "",
          "maxLength": 6000,
          "title": "Abstract",
          "type": "string"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Authors",
          "type": "array"
        },
        "canonical_venue": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Venue"
        },
        "content_type": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type"
        },
        "direct_pdf_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direct Pdf Url"
        },
        "doi": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "final_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Url"
        },
        "github_evidence_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github Evidence Url"
        },
        "github_license_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github License Id"
        },
        "github_repository_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github Repository Url"
        },
        "github_status": {
          "default": "not_found",
          "enum": [
            "not_found",
            "search_matched",
            "verified_open_source"
          ],
          "title": "Github Status",
          "type": "string"
        },
        "landing_page_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Landing Page Url"
        },
        "local_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "paper_id": {
          "pattern": "^paper-[a-zA-Z0-9_-]{1,64}$",
          "title": "Paper Id",
          "type": "string"
        },
        "portfolio_bucket": {
          "default": "ineligible",
          "enum": [
            "authoritative",
            "recent",
            "fallback",
            "ineligible"
          ],
          "title": "Portfolio Bucket",
          "type": "string"
        },
        "publication_type": {
          "default": "other",
          "enum": [
            "conference",
            "journal",
            "preprint",
            "other"
          ],
          "title": "Publication Type",
          "type": "string"
        },
        "quality_tier": {
          "default": "other",
          "enum": [
            "authoritative",
            "established_peer_reviewed",
            "recent_peer_reviewed",
            "recent_arxiv",
            "arxiv_fallback",
            "other"
          ],
          "title": "Quality Tier",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 1000,
          "title": "Reason",
          "type": "string"
        },
        "relevance_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Relevance Score",
          "type": "number"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "source": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "downloaded",
            "discovered",
            "requires_review",
            "duplicate",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "venue": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 2200,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "paper_id",
        "title",
        "source",
        "status"
      ],
      "title": "PaperRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authoritative_downloaded_count": {
      "default": 0,
      "minimum": 0,
      "title": "Authoritative Downloaded Count",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "discovered_count": {
      "minimum": 0,
      "title": "Discovered Count",
      "type": "integer"
    },
    "downloaded_count": {
      "minimum": 0,
      "title": "Downloaded Count",
      "type": "integer"
    },
    "github_marked_count": {
      "default": 0,
      "minimum": 0,
      "title": "Github Marked Count",
      "type": "integer"
    },
    "manifest_purpose": {
      "default": "portfolio_selection",
      "enum": [
        "portfolio_selection",
        "evidence_consolidation"
      ],
      "title": "Manifest Purpose",
      "type": "string"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/DownloadPolicyRecord"
    },
    "portfolio_compliant": {
      "default": false,
      "title": "Portfolio Compliant",
      "type": "boolean"
    },
    "quality_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/PaperQualityPolicyRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "recent_downloaded_count": {
      "default": 0,
      "minimum": 0,
      "title": "Recent Downloaded Count",
      "type": "integer"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/PaperRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "rejected_count": {
      "default": 0,
      "minimum": 0,
      "title": "Rejected Count",
      "type": "integer"
    },
    "required_evidence_complete": {
      "default": false,
      "title": "Required Evidence Complete",
      "type": "boolean"
    },
    "required_paper_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 500,
      "title": "Required Paper Ids",
      "type": "array"
    },
    "requires_review_count": {
      "minimum": 0,
      "title": "Requires Review Count",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "search_result_count": {
      "minimum": 0,
      "title": "Search Result Count",
      "type": "integer"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "objective",
    "query",
    "search_result_count",
    "downloaded_count",
    "discovered_count",
    "requires_review_count",
    "policy"
  ],
  "title": "PaperManifest",
  "type": "object"
}
