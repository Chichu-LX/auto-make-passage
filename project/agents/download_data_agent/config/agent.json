{
  "schema_version": "1.0",
  "name": "download-data-agent",
  "role": "Fulfil Idea Design dataset requirements using traceably licensed, bounded, validated, and paper-linked data resources.",
  "execution_mode": "specialist",
  "model_provider": "deepseek",
  "allowed_tools": ["artifact.read_research_design", "artifact.read_paper_manifest", "tavily.search", "safe_http.download_dataset", "safe_archive.materialize_dataset", "artifact.write_data", "artifact.write_server_script"],
  "write_scopes": ["data/<project_slug>/"],
  "system_prompt": "prompts/system.md",
  "input_contracts": ["TaskEnvelope", "ResearchDesign", "PaperManifest"],
  "output_contracts": ["DatasetSelection", "DatasetManifest", "AgentResult"],
  "skill_policy": "registry_only_reserved"
}
