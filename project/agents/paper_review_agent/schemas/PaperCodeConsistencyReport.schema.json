{
  "$defs": {
    "AgentName": {
      "enum": [
        "lead-agent",
        "download-paper-agent",
        "download-data-agent",
        "make-idea-agent",
        "idea-design-agent",
        "code-make-agent",
        "code-review-agent",
        "server-schedule-agent",
        "check-result-agent",
        "experiment-code-run-agent",
        "check-paper-and-code-agent",
        "write-paper-agent",
        "paper-review-agent",
        "feedback-agent"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "PaperClaimAudit": {
      "additionalProperties": false,
      "properties": {
        "citation_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Citation Ids",
          "type": "array"
        },
        "claim_id": {
          "pattern": "^claim-[a-zA-Z0-9_-]{1,80}$",
          "title": "Claim Id",
          "type": "string"
        },
        "code_file_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Code File Paths",
          "type": "array"
        },
        "result_keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Result Keys",
          "type": "array"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "warning"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 3000,
          "minLength": 10,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "status",
        "summary"
      ],
      "title": "PaperClaimAudit",
      "type": "object"
    },
    "PaperConsistencyAdvisoryDraft": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "$ref": "#/$defs/PaperConsistencyAdvisoryFinding"
          },
          "maxItems": 100,
          "title": "Findings",
          "type": "array"
        },
        "summary": {
          "maxLength": 6000,
          "minLength": 10,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "title": "PaperConsistencyAdvisoryDraft",
      "type": "object"
    },
    "PaperConsistencyAdvisoryFinding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "original_paper_comparison",
            "formula_semantics",
            "method_description",
            "result_interpretation",
            "claim_scope"
          ],
          "title": "Category",
          "type": "string"
        },
        "citation_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Citation Ids",
          "type": "array"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Claim Ids",
          "type": "array"
        },
        "finding_id": {
          "pattern": "^advisory-[a-zA-Z0-9_-]{1,80}$",
          "title": "Finding Id",
          "type": "string"
        },
        "formula_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Formula Ids",
          "type": "array"
        },
        "recommendation": {
          "maxLength": 3000,
          "minLength": 10,
          "title": "Recommendation",
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "summary": {
          "maxLength": 3000,
          "minLength": 10,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "category",
        "severity",
        "summary",
        "recommendation"
      ],
      "title": "PaperConsistencyAdvisoryFinding",
      "type": "object"
    },
    "PaperConsistencyCheck": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "manuscript_integrity",
            "citation_pdf",
            "original_paper_comparison",
            "formula_code",
            "method_code",
            "experiment_result",
            "claim_evidence",
            "claim_scope"
          ],
          "title": "Category",
          "type": "string"
        },
        "check_id": {
          "pattern": "^paper-check-[a-z0-9-]{2,100}$",
          "title": "Check Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence",
          "type": "array"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "warning"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 3000,
          "minLength": 10,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "category",
        "status",
        "summary"
      ],
      "title": "PaperConsistencyCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic and advisory comparison of paper, original sources, code, and results.",
  "properties": {
    "advisory": {
      "$ref": "#/$defs/PaperConsistencyAdvisoryDraft"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Blockers",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/PaperConsistencyCheck"
      },
      "maxItems": 200,
      "minItems": 7,
      "title": "Checks",
      "type": "array"
    },
    "claim_audits": {
      "items": {
        "$ref": "#/$defs/PaperClaimAudit"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Claim Audits",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "manuscript_manifest_uri": {
      "title": "Manuscript Manifest Uri",
      "type": "string"
    },
    "project_slug": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
      "title": "Project Slug",
      "type": "string"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Recommendations",
      "type": "array"
    },
    "recommended_route": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentName"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "maxLength": 6000,
      "minLength": 10,
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "passed",
        "needs_revision"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "project_slug",
    "manuscript_manifest_uri",
    "verdict",
    "summary",
    "checks",
    "claim_audits",
    "advisory"
  ],
  "title": "PaperCodeConsistencyReport",
  "type": "object"
}
