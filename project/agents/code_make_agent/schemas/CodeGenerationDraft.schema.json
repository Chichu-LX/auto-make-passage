{
  "$defs": {
    "CodeTraceabilityItem": {
      "additionalProperties": false,
      "properties": {
        "acceptance_test": {
          "maxLength": 2000,
          "minLength": 5,
          "title": "Acceptance Test",
          "type": "string"
        },
        "dataset_keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Dataset Keys",
          "type": "array"
        },
        "design_component_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Design Component Ids",
          "type": "array"
        },
        "experiment_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Experiment Ids",
          "type": "array"
        },
        "file_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "File Paths",
          "type": "array"
        },
        "requirement": {
          "maxLength": 2000,
          "minLength": 5,
          "title": "Requirement",
          "type": "string"
        },
        "source_module_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Source Module Ids",
          "type": "array"
        }
      },
      "required": [
        "requirement",
        "file_paths",
        "acceptance_test"
      ],
      "title": "CodeTraceabilityItem",
      "type": "object"
    },
    "GeneratedCodeFileDraft": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 120000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "dataset_keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Dataset Keys",
          "type": "array"
        },
        "design_component_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Design Component Ids",
          "type": "array"
        },
        "experiment_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Experiment Ids",
          "type": "array"
        },
        "language": {
          "enum": [
            "python",
            "toml",
            "yaml",
            "json",
            "markdown",
            "text"
          ],
          "title": "Language",
          "type": "string"
        },
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "purpose": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Purpose",
          "type": "string"
        },
        "source_module_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Source Module Ids",
          "type": "array"
        }
      },
      "required": [
        "path",
        "purpose",
        "language",
        "content"
      ],
      "title": "GeneratedCodeFileDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "architecture_summary": {
      "maxLength": 6000,
      "minLength": 20,
      "title": "Architecture Summary",
      "type": "string"
    },
    "dependencies": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Dependencies",
      "type": "array"
    },
    "entrypoints": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Entrypoints",
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/GeneratedCodeFileDraft"
      },
      "maxItems": 80,
      "minItems": 10,
      "title": "Files",
      "type": "array"
    },
    "known_gaps": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Known Gaps",
      "type": "array"
    },
    "package_name": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "title": "Package Name",
      "type": "string"
    },
    "traceability": {
      "items": {
        "$ref": "#/$defs/CodeTraceabilityItem"
      },
      "maxItems": 40,
      "minItems": 2,
      "title": "Traceability",
      "type": "array"
    },
    "validation_commands": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "minItems": 2,
      "title": "Validation Commands",
      "type": "array"
    }
  },
  "required": [
    "package_name",
    "architecture_summary",
    "files",
    "entrypoints",
    "dependencies",
    "validation_commands",
    "traceability"
  ],
  "title": "CodeGenerationDraft",
  "type": "object"
}
