{
  "$defs": {
    "AgentName": {
      "enum": [
        "lead-agent",
        "download-paper-agent",
        "download-data-agent",
        "make-idea-agent",
        "idea-design-agent",
        "code-make-agent",
        "code-review-agent",
        "server-schedule-agent",
        "check-result-agent",
        "experiment-code-run-agent",
        "check-paper-and-code-agent",
        "write-paper-agent",
        "paper-review-agent",
        "feedback-agent"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "generic",
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "default": "",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "JobObservation": {
      "additionalProperties": false,
      "properties": {
        "best_checkpoint_path": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best Checkpoint Path"
        },
        "best_metric": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "job_id": {
          "pattern": "^job-[a-zA-Z0-9_-]{1,100}$",
          "title": "Job Id",
          "type": "string"
        },
        "log_tail": {
          "default": "",
          "maxLength": 16000,
          "title": "Log Tail",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricObservation"
          },
          "maxItems": 10000,
          "title": "Metrics",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "status"
      ],
      "title": "JobObservation",
      "type": "object"
    },
    "MetricGateCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "pattern": "^metric-[a-z0-9-]{2,100}$",
          "title": "Check Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "higher",
            "lower"
          ],
          "title": "Direction",
          "type": "string"
        },
        "metric_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Value"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "pending"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 5,
          "title": "Summary",
          "type": "string"
        },
        "target_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Value"
        }
      },
      "required": [
        "check_id",
        "metric_name",
        "status",
        "direction",
        "summary"
      ],
      "title": "MetricGateCheck",
      "type": "object"
    },
    "MetricObservation": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_path": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Path"
        },
        "metric_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric_name",
        "value"
      ],
      "title": "MetricObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One persistent result-monitoring report; running reports repeat without a retry cap.",
  "properties": {
    "best_log_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 2000,
      "title": "Best Log Artifacts",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Issues",
      "type": "array"
    },
    "metric_checks": {
      "items": {
        "$ref": "#/$defs/MetricGateCheck"
      },
      "maxItems": 200,
      "title": "Metric Checks",
      "type": "array"
    },
    "next_report_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Report At"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/JobObservation"
      },
      "maxItems": 2000,
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "project_slug": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
      "title": "Project Slug",
      "type": "string"
    },
    "recommended_route": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentName"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "report_interval_seconds": {
      "const": 43200,
      "default": 43200,
      "title": "Report Interval Seconds",
      "type": "integer"
    },
    "report_sequence": {
      "minimum": 1,
      "title": "Report Sequence",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schedule_manifest_uri": {
      "title": "Schedule Manifest Uri",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "maxLength": 6000,
      "minLength": 10,
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "in_progress",
        "passed",
        "needs_improvement",
        "failed"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "project_slug",
    "schedule_manifest_uri",
    "report_sequence",
    "verdict",
    "summary",
    "observations"
  ],
  "title": "ResultCheckReport",
  "type": "object"
}
