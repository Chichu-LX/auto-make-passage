{
  "$defs": {
    "AgentIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "root_cause_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Root Cause Key"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ],
      "title": "AgentIssue",
      "type": "object"
    },
    "AgentName": {
      "enum": [
        "lead-agent",
        "download-paper-agent",
        "download-data-agent",
        "make-idea-agent",
        "idea-design-agent",
        "code-make-agent",
        "code-review-agent",
        "server-schedule-agent",
        "check-result-agent",
        "experiment-code-run-agent",
        "check-paper-and-code-agent",
        "write-paper-agent",
        "paper-review-agent",
        "feedback-agent"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "generic",
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "default": "",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "FeedbackControl": {
      "additionalProperties": false,
      "description": "Typed, advisory control that the Runtime must validate before applying.",
      "properties": {
        "action": {
          "enum": [
            "continue",
            "retry",
            "request_human",
            "abort"
          ],
          "title": "Action",
          "type": "string"
        },
        "issue_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Issue Codes",
          "type": "array"
        },
        "observed_log_count": {
          "default": 0,
          "minimum": 0,
          "title": "Observed Log Count",
          "type": "integer"
        },
        "reason": {
          "maxLength": 3000,
          "minLength": 5,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        },
        "target_agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action",
        "severity",
        "reason"
      ],
      "title": "FeedbackControl",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentName"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "evidence": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Evidence",
      "type": "array"
    },
    "feedback_control": {
      "anyOf": [
        {
          "$ref": "#/$defs/FeedbackControl"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/AgentIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "needs_human": {
      "default": false,
      "title": "Needs Human",
      "type": "boolean"
    },
    "route_hint": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentName"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "in_progress",
        "failed",
        "blocked",
        "needs_human"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "agent",
    "status",
    "summary"
  ],
  "title": "AgentResult",
  "type": "object"
}
