# Copy this file to .env, fill exactly one authentication mode, then run:
# chmod 600 project/agents/server_schedule_agent/.env
#
# The prefix GPU_SERVER_A must match credential_prefix in servers.local.json.
SERVER_GPU_SERVER_A_HOST=
SERVER_GPU_SERVER_A_PORT=22
SERVER_GPU_SERVER_A_USER=

# Password authentication
SERVER_GPU_SERVER_A_AUTH_MODE=password
SERVER_GPU_SERVER_A_PASSWORD=

# Key authentication: change AUTH_MODE to key, leave PASSWORD empty, and set an
# absolute path. The key must be a regular non-symlink file inaccessible to
# group/world users. Passphrase may be empty for an unencrypted private key.
SERVER_GPU_SERVER_A_PRIVATE_KEY_PATH=
SERVER_GPU_SERVER_A_PRIVATE_KEY_PASSPHRASE=
