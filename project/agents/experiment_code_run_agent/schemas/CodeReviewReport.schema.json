{
  "$defs": {
    "CodeReviewCheck": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "architecture",
            "traceability",
            "design_alignment",
            "scientific_protocol",
            "vendored_source",
            "static_analysis",
            "execution",
            "training_update",
            "reliability"
          ],
          "title": "Category",
          "type": "string"
        },
        "check_id": {
          "pattern": "^review-[a-z0-9-]{2,80}$",
          "title": "Check Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Evidence",
          "type": "array"
        },
        "file_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "File Paths",
          "type": "array"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "warning"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 3000,
          "minLength": 5,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "category",
        "status",
        "summary"
      ],
      "title": "CodeReviewCheck",
      "type": "object"
    },
    "CodeReviewExecutionRecord": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Argv",
          "type": "array"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "execution_id": {
          "enum": [
            "minimal_demo_first",
            "minimal_demo_repeat",
            "unit_tests"
          ],
          "title": "Execution Id",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "return_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Code"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "timed_out"
          ],
          "title": "Status",
          "type": "string"
        },
        "stderr_tail": {
          "default": "",
          "maxLength": 8000,
          "title": "Stderr Tail",
          "type": "string"
        },
        "stdout_tail": {
          "default": "",
          "maxLength": 8000,
          "title": "Stdout Tail",
          "type": "string"
        },
        "timeout_seconds": {
          "maximum": 120,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "execution_id",
        "argv",
        "status",
        "duration_ms",
        "timeout_seconds"
      ],
      "title": "CodeReviewExecutionRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic review verdict plus actionable Code Make repair instructions.",
  "properties": {
    "blockers": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Blockers",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CodeReviewCheck"
      },
      "maxItems": 100,
      "minItems": 7,
      "title": "Checks",
      "type": "array"
    },
    "code_manifest_uri": {
      "title": "Code Manifest Uri",
      "type": "string"
    },
    "covered_component_ids": {
      "items": {
        "type": "string"
      },
      "title": "Covered Component Ids",
      "type": "array"
    },
    "covered_dataset_keys": {
      "items": {
        "type": "string"
      },
      "title": "Covered Dataset Keys",
      "type": "array"
    },
    "covered_experiment_ids": {
      "items": {
        "type": "string"
      },
      "title": "Covered Experiment Ids",
      "type": "array"
    },
    "covered_source_module_ids": {
      "items": {
        "type": "string"
      },
      "title": "Covered Source Module Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "executions": {
      "items": {
        "$ref": "#/$defs/CodeReviewExecutionRecord"
      },
      "maxItems": 10,
      "minItems": 3,
      "title": "Executions",
      "type": "array"
    },
    "project_slug": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
      "title": "Project Slug",
      "type": "string"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Recommendations",
      "type": "array"
    },
    "review_iteration": {
      "maximum": 5,
      "minimum": 1,
      "title": "Review Iteration",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "maxLength": 6000,
      "minLength": 10,
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "passed",
        "needs_revision"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "project_slug",
    "code_manifest_uri",
    "review_iteration",
    "verdict",
    "summary",
    "checks",
    "executions"
  ],
  "title": "CodeReviewReport",
  "type": "object"
}
