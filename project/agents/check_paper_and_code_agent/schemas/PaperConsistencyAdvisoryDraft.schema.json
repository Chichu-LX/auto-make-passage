            "original_paper_comparison",
            "formula_semantics",
            "method_description",
            "result_interpretation",
            "claim_scope"
          ],
          "title": "Category",
          "type": "string"
        },
        "citation_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Citation Ids",
          "type": "array"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Claim Ids",
          "type": "array"
        },
        "finding_id": {
          "pattern": "^advisory-[a-zA-Z0-9_-]{1,80}$",
          "title": "Finding Id",
          "type": "string"
        },
        "formula_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Formula Ids",
          "type": "array"
        },
        "recommendation": {
          "maxLength": 3000,
          "minLength": 10,
