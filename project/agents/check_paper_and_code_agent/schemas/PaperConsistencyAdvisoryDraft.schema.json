          "title": "Severity",
          "type": "string"
        },
        "summary": {
          "maxLength": 3000,
          "minLength": 10,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "category",
        "severity",
        "summary",
        "recommendation"
      ],
      "title": "PaperConsistencyAdvisoryFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "findings": {
