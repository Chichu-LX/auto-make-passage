        "$ref": "#/$defs/PaperConsistencyAdvisoryFinding"
      },
      "maxItems": 100,
      "title": "Findings",
      "type": "array"
    },
    "summary": {
      "maxLength": 6000,
      "minLength": 10,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "summary"
  ],
  "title": "PaperConsistencyAdvisoryDraft",
  "type": "object"
